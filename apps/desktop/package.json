{
  "name": "@cairn/desktop",
  "version": "0.1.0",
  "description": "Cairn — A Discipline-First Trading Journal (Electron desktop app)",
  "private": true,
  "main": "out/main/main.js",
  "author": "Jai Akash",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
