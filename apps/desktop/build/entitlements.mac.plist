<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's V8 JIT requires these two under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- better-sqlite3 and keytar ship prebuilt native binaries signed outside this
       build; without this, the hardened runtime refuses to load them. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Sync, billing and broker (cTrader) features need outbound HTTPS. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
