{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"],
      // Type-only redirect: use the narrow shim in types/ instead of the package's
      // ~120 KB generated declaration, which OOMs the type-aware ESLint checker.
      // Runtime/bundler resolution is unaffected. See types/libsodium-wrappers-sumo.d.ts.
      "libsodium-wrappers-sumo": ["./types/libsodium-wrappers-sumo.d.ts"]
    }
  },
  "include": ["src", "shared"]
}
