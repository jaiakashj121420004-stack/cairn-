{
  "name": "@cairn/server",
  "version": "0.1.0",
  "description": "Cairn — backend API (Fastify + Postgres). Auth, vault storage, billing webhooks (v2.0, CLAUDE.md §18.5)",
  "private": true,
  "type": "module",
  "author": "Jai Akash",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cairn/shared-types": "workspace:*",
    "@cairn/shared-zod": "workspace:*",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "10.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.2.2",
    "@node-rs/argon2": "2.0.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.2.1",
    "jose": "5.9.6",
    "pino": "9.6.0",
    "postgres": "3.4.5",
    "stripe": "17.7.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "drizzle-kit": "0.31.10",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-promise": "7.3.0",
    "pino-pretty": "13.0.0",
    "resend": "4.0.1",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
