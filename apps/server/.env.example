# Cairn server environment (CLAUDE.md §19.8).
# Copy to .env and fill in. NEVER commit a real .env — it is gitignored.
# Every value below is a non-secret placeholder.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Postgres. Matches docker-compose.yml defaults.
DATABASE_URL=postgres://cairn:cairn@localhost:5432/cairn

# Server-side pepper, HMAC-ed into every password before Argon2id. Min 32 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_PEPPER=replace-with-64-hex-chars-of-entropy-min-32-characters

# HS256 access-token signing secret. Min 32 chars. Generate the same way as above.
JWT_SECRET=replace-with-64-hex-chars-of-entropy-min-32-characters
JWT_ISSUER=cairn
JWT_AUDIENCE=cairn-client

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Breached-password screening (HIBP k-anonymity) at signup + reset. on|off (default on).
# Fails open if HIBP is unreachable, so it never blocks signup on an outage.
HIBP_CHECK=on

# Comma-separated allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173

# Public base URL used to build email links.
APP_URL=http://localhost:5173

# Email: console (logs links), resend (real), memory (tests only).
EMAIL_PROVIDER=console
EMAIL_FROM=Cairn <no-reply@cairn.app>
# RESEND_API_KEY=re_xxx   # required only when EMAIL_PROVIDER=resend

BODY_LIMIT_BYTES=65536

# Force-set whether the refresh cookie requires Secure. Defaults to on in
# production, off otherwise. Set to true behind TLS-terminating proxies in dev.
# COOKIE_SECURE=false

# ── Billing (CLAUDE.md §20, docs/billing.md) ─────────────────────────────────────────────
# Every provider is OPTIONAL: a provider is only instantiated when ALL of its secrets are
# present, so a deployment can ship with any subset (Dodo only, Stripe only, both, none).
# NEVER commit real keys. Webhook secrets verify inbound signatures (§2.13) — keep secret.
#
# Provider routing (§20.6): when Dodo is configured it is the DEFAULT gateway for every
# country. Otherwise IN ⇒ Razorpay, else ⇒ Stripe.

# Dodo Payments — default gateway when configured. Handles India GST + international tax.
# DODO_API_KEY=dodo_test_xxx
# DODO_WEBHOOK_SECRET=whsec_xxx          # Standard Webhooks signing secret (Developer > Webhooks)
# DODO_PRODUCT_ID=prod_xxx               # monthly Pro subscription product id
# DODO_PRODUCT_ID_ANNUAL=prod_xxx        # optional; annual Pro product (falls back to monthly)
# DODO_ENVIRONMENT=test                  # test | live (defaults to test)

# Stripe — used for non-India when Dodo is not configured. Stripe Tax adds VAT/sales tax.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_ID=price_xxx              # monthly Pro price id
# STRIPE_PRICE_ID_ANNUAL=price_xxx       # optional; annual Pro price (falls back to monthly)

# Razorpay — used for India (UPI / INR / GST) when Dodo is not configured.
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_PLAN_ID=plan_xxx              # monthly Pro plan id
# RAZORPAY_PLAN_ID_ANNUAL=plan_xxx       # optional; annual Pro plan (falls back to monthly)
# RAZORPAY_WEBHOOK_SECRET=xxx

# Checkout / upgrade redirect targets. Default under APP_URL when unset.
# BILLING_SUCCESS_URL=http://localhost:5173/billing/success
# BILLING_CANCEL_URL=http://localhost:5173/billing/cancel
# BILLING_PORTAL_RETURN_URL=http://localhost:5173/settings/billing
# BILLING_UPGRADE_URL=http://localhost:5173/pricing

# ── Observability (CLAUDE.md §18.9) ─────────────────────────────────────────────────────
# Sentry: server-side error reporting is always-on once a DSN is set (no opt-in — the
# server never holds user content, only operational errors). Unset = disabled.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=

# OpenTelemetry: traces + metrics export to an OTLP collector (Grafana Tempo Cloud /
# Honeycomb free tier both accept OTLP/HTTP). Unset endpoint = tracing/metrics disabled.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway.example.com
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=replace-with-api-key
OTEL_TRACES_SAMPLE_RATIO=0.1
OTEL_SLOW_SPAN_MS=1000
OTEL_METRIC_EXPORT_INTERVAL_MS=15000
