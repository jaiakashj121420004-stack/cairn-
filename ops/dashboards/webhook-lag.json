{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Metrics datasource receiving the cairn-api OTLP export.",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.4.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "title": "Cairn Webhook Health & Lag",
  "uid": "cairn-webhook-lag",
  "description": "Billing webhook receive rate, duplicate (idempotency-replay) rate by provider, and processing latency for the webhook routes (a proxy for delivery-to-processing lag). Source instruments: webhook_received_total, http_requests_total{route=~\"/webhooks/.*\"}, http_request_duration_ms (apps/server/src/telemetry/metrics.ts).",
  "tags": ["cairn", "billing", "webhooks"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Webhook deliveries received, by provider/outcome",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 30 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, outcome) (increase(webhook_received_total[1h]))",
          "legendFormat": "{{provider}} ({{outcome}})"
        }
      ]
    },
    {
      "id": 2,
      "title": "Duplicate (replay) rate by provider",
      "type": "timeseries",
      "description": "A rising duplicate rate often indicates a slow consumer causing the provider to retry deliveries.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (rate(webhook_received_total{outcome=\"duplicate\"}[1h])) / sum by (provider) (rate(webhook_received_total[1h]))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Webhook route p95 processing latency",
      "type": "timeseries",
      "description": "histogram_quantile over http_request_duration_ms for /webhooks/* routes — the time from receipt to handler completion. If the OTLP-to-Prometheus bridge renames the histogram, adjust the metric name accordingly.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_ms_bucket{route=~\"/webhooks/.*\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Webhook 5xx rate (delivery failures)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total{route=~\"/webhooks/.*\", status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    }
  ]
}
