# Cairn — environment variables (desktop client)
# No secrets are required to run the app — everything is local-first (§2.4).
# Copy to .env for local overrides (.env is gitignored, §19.8).

# NODE_ENV is set automatically by electron-vite
# NODE_ENV=development

# ── Opt-in crash telemetry (§2.4, §2.13, §19.9) ──────────────────────────────
# Telemetry defaults to OFF and is gated by the user setting `telemetry.optIn`.
# Sentry initialises ONLY when the user has opted in AND a DSN is present here.
# Leave blank to guarantee no crash reporting endpoint is ever contacted.
# SENTRY_DSN=
# CAIRN_SENTRY_DSN=

