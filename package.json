{
  "name": "cairn",
  "version": "0.1.0",
  "description": "Cairn — A Discipline-First Trading Journal (workspace root)",
  "private": true,
  "author": "Jai Akash",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @cairn/desktop run dev",
    "build": "pnpm --filter @cairn/desktop run build",
    "typecheck": "pnpm --filter @cairn/desktop run typecheck",
    "lint": "pnpm --filter @cairn/desktop run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @cairn/desktop run test",
    "test:unit": "pnpm --filter @cairn/desktop run test:unit",
    "test:coverage": "pnpm --filter @cairn/desktop run test:coverage",
    "test:e2e": "pnpm --filter @cairn/desktop run test:e2e",
    "check-licenses": "tsx scripts/check-licenses.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.4.2",
    "tsx": "^4.22.4"
  },
  "pnpm": {
    "overrides": {},
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
